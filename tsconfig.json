{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "declaration": true, "outDir": "dist", "rootDir": ".",
    "skipLibCheck": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts", "team.config.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
