{
  "name": "bot-team-xstate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "XState execution core for Bot Team v0.4",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev": "node scripts/dev.mjs",
    "start": "node --import tsx scripts/web.ts",
    "test": "node scripts/test.mjs",
    "demo": "node --import tsx examples/collaboration.ts",
    "model:run": "node --import tsx examples/model-service.ts",
    "coverage:specs": "node --import tsx scripts/spec-coverage.ts",
    "test:bdd": "node scripts/run-bdd.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "agents": "0.30.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "3.2.7"
  }
}
