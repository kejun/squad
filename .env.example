# Copy this file to .env. Model IDs and endpoints are placeholders.
# Existing process environment variables take precedence. Restart after changing model settings.
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_NAME=YOUR_MODEL_ID
MODEL_API_KEY=
MODEL_JSON_MODE=true
# MODEL_TEMPERATURE=0.2
# MODEL_MAX_TOKENS=8192
# MODEL_EXTRA_BODY={"enable_thinking":false}
# For a local service without authentication: MODEL_NO_AUTH=true

# Optional model overrides for the 5 bots. Blank values inherit defaults.
A_MODEL_NAME=
B_MODEL_NAME=
BUILDER_1_MODEL_NAME=
BUILDER_2_MODEL_NAME=
BUILDER_3_MODEL_NAME=

# Example: Builder 3 uses another provider. Fill in all required values.
BUILDER_3_MODEL_BASE_URL=
BUILDER_3_MODEL_API_KEY=
# BUILDER_3_MODEL_JSON_MODE=false

# Background facilitator and final check can use independent models as well.
FACILITATOR_MODEL_NAME=
CHECK_MODEL_NAME=

# Every role prefix supports BASE_URL, NAME, API_KEY, NO_AUTH, JSON_MODE,
# TEMPERATURE, MAX_TOKENS, EXTRA_BODY, e.g. A_MODEL_BASE_URL, CHECK_MODEL_API_KEY.
# Changing BASE_URL requires that role's API_KEY, or explicit NO_AUTH=true.
# Never put real secrets in this example file; use the ignored .env file.

# Cloudflare Agents SDK web_search / web_fetch: enabled for every bot by default.
# CLOUDFLARE_* values reload before each web tool call; changing the enabled switch needs a restart.
# Search needs Workers AI: Read + AI Gateway: Read and gateway credits or a provider key.
# HTML/PDF conversion uses the Workers AI REST API; Markdown/JSON/plain text need no key.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# SQUAD_WEB_TOOLS_ENABLED=false
# CLOUDFLARE_AI_GATEWAY_ID=default
# CLOUDFLARE_WEB_SEARCH_PROVIDER=ceramic
# CLOUDFLARE_WEB_SEARCH_BYOK_ALIAS=default
